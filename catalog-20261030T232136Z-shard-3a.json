mmy Hall所经营的偏远旅馆所困。Jimmy绑架了Maya的朋友，并出于恶意将他们锁定在房间里。Maya设法逃脱了，但Jimmy四处寻找她。要使他释放朋友，Maya必须揭露Jimmy的黑暗秘密。通过使用她发现的古代鬼声接收器，Maya与Jimmy过去的鬼魂进行交流，这些鬼魂在酒店周围逐渐形成并逐渐揭示他们的故事。 \r\n\r\n\r\nAt Dead Of Night is part horror film, part horror game and part ghost hunt. It blends live-action and graphics to create a unique immersive horror experience like no other.","description_language":"Bangumi 原文","sources":{"description":{"source":"bangumi_exact_title_or_alias","source_url":"https://bgm.tv/subject/330117","matched_name":"At Dead Of Night","checked_at":"2026-10-14T05:51:09+00:00"},"description_language":{"source":"bangumi_exact_title_or_alias","source_url":"https://bgm.tv/subject/330117","matched_name":"At Dead Of Night","checked_at":"2026-10-14T05:51:09+00:00"},"developers":{"source":"bangumi_exact_title_or_alias","source_url":"https://bgm.tv/subject/330117","matched_name":"At Dead Of Night","checked_at":"2026-10-14T05:51:09+00:00"},"publishers":{"source":"bangumi_exact_title_or_alias","source_url":"https://bgm.tv/subject/330117","matched_name":"At Dead Of Night","checked_at":"2026-10-14T05:51:09+00:00"},"release_date":{"source":"bangumi_exact_title_or_alias","source_url":"https://bgm.tv/subject/330117","matched_name":"At Dead Of Night","checked_at":"2026-10-14T05:51:09+00:00"},"tags":{"source":"bangumi_exact_title_or_alias","source_url":"https://bgm.tv/subject/330117","matched_name":"At Dead Of Night","checked_at":"2026-10-14T05:51:09+00:00"},"platforms":{"source":"pcgamingwiki","source_url":"https://www.pcgamingwiki.com/wiki/At_Dead_of_Night","matched_name":"At Dead of Night","match_rule":"exact_title_or_verified_alias","checked_at":"2026-10-14T05:51:09.818638+00:00"}},"developers":["Baggy Cat Ltd."],"publishers":["Baggy Cat Ltd."],"release_date":"2020-01-01","tags":["STEAM","PC","恐怖","Horror","游戏","解谜"],"platforms":["Windows"]},"metadata_sources":{"name_zh":{"source":"bilibili_index_translate","machine_translated":true,"model":"Index-Translate-35B-A3B","source_url":"https://index-